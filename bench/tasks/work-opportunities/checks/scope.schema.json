{
  "type": "object",
  "required": [
    "intent",
    "scenarios"
  ],
  "properties": {
    "intent": {
      "type": "string",
      "minLength": 1
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "then",
          "check"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "then": {
            "type": "string",
            "minLength": 1
          },
          "check": {
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "enum": [
                  "run",
                  "file",
                  "http",
                  "eval",
                  "review",
                  "human"
                ]
              },
              "cmd": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  }
}
